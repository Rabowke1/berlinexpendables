{
  "name": "berlin-expendables",
  "version": "0.1.0",
  "private": true,
  "description": "Berlin Expendables - 4-Spieler Lokal-Koop Run'n'Gun in 2D-Pixel-Art",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "assets": "tsx tools/spritegen/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tools/tsconfig.json",
    "shot": "node scripts/shot.mjs",
    "check": "npm run assets && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
